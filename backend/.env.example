# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string.
DATABASE_URL="postgresql://zvote_user:zvote_password@localhost:5432/zvote?schema=public"

# Secret used to sign JWTs. Use a long, random string in production.
JWT_SECRET=replace_with_a_long_random_secret

# Port the Express API listens on.
PORT=5000

# Private key of the election authority wallet. This is the ONLY wallet that ever
# signs blockchain transactions -- voters never touch a wallet directly.
PRIVATE_KEY=0xyourprivatekeyhere

# Address of the deployed ZVote contract (printed by blockchain/scripts/deploy.js).
CONTRACT_ADDRESS=0xdeployedContractAddressHere

# JSON-RPC endpoint to reach the blockchain. Point this at your local Hardhat node
# (http://127.0.0.1:8545) for local development, or the Polygon Amoy RPC URL for the
# testnet deployment.
RPC_URL=http://127.0.0.1:8545

# Comma-separated list of allowed CORS origins (the frontend's URL(s)).
CORS_ORIGIN=http://localhost:5173

# SMTP Email Configuration (Optional, falls back to console logging in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@zvote.org
