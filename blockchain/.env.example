# Copy this file to .env and fill in real values. Never commit the real .env file.

# Private key of the election authority wallet (used to deploy & administer the
# contract on Amoy). Must be funded with test MATIC/POL from a Polygon Amoy faucet.
# Do NOT prefix with "0x" is fine either way; ethers accepts both.
PRIVATE_KEY=0xyourprivatekeyhere

# Polygon Amoy testnet RPC endpoint.
AMOY_RPC_URL=https://polygon-amoy.drpc.org
